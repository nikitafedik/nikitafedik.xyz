{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/publications/",
      "destination": "/publications.html",
      "permanent": true
    },
    {
      "source": "/projects/",
      "destination": "/projects.html",
      "permanent": true
    },
    {
      "source": "/about-me/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/cv/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/posts(/.*)?",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/categories(/.*)?",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/tags(/.*)?",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/archives(/.*)?",
      "destination": "/",
      "permanent": true
    }
  ]
}
